# Project Biometal - FuncOS Development Configuration
# Hardware-aware, specification-first OS development

# === Core Architecture ===
PROJECT_NAME=biometal
OS_NAME=funcos
VERSION=0.1.0

# === Hardware Configuration ===
TARGET_ARCH=x86_64
# Options: x86_64, arm64, auto (detect), multi (build all)
HARDWARE_PROFILE=detect
# Options: detect, desktop, server, embedded, vm

# === Build Configuration ===
BUILD_MODE=debug
# Options: debug, release, profile
BUILD_STRATEGY=off-the-shelf
# Options: off-the-shelf, custom, hybrid
TOOLCHAIN=zig
# Options: zig, rust, gcc, clang
PARALLEL_JOBS=4

# === FuncOS Runtime ===
FUNCOS_MODE=development
# Options: development, production, testing
NEURAL_INTERFACE=stub
# Options: stub, mock, real, disabled
EXECUTION_ACTUALIZER=software
# Options: software, hardware, hybrid

# === Development Services ===
DEV_PORT=8080
DEBUG_PORT=2345
DOCS_PORT=3000
LOG_LEVEL=info
# Options: debug, info, warn, error

# === VM & Testing ===
QEMU_MEMORY=64M
QEMU_CPU=486
TEST_SUITE=all
# Options: unit, integration, vm, all

# === Remote Agent Optimization ===
AGENT_MODE=enabled
# Options: enabled, disabled, auto
AGENT_PARALLEL=true
AGENT_TIMEOUT=300

# === WebAXP Integration ===
WEBAXP_COMPLIANCE=strict
# Options: strict, relaxed, disabled
SPEC_VALIDATION=enabled
OUTPUT_FORMAT=elf
# Options: elf, bin, iso, docker

# === ZealOS Integration ===
ZEALOS_VERSION=latest
ZEALOS_INTEGRATION=enabled
# Options: enabled, disabled, testing

# === Advanced Configuration ===
# Override with: docker-compose --env-file custom.env up
MEMORY_SAFETY=controlled
# Options: safe, controlled, unsafe
INTROSPECTION_LEVEL=full
# Options: minimal, standard, full, neural
