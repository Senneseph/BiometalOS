# IFLib Development Environment Configuration

# Project Information
PROJECT_NAME=IFLib
PROJECT_TYPE=function-library
PROJECT_DESCRIPTION="Intermediate Form Library with function specifications and optimizations"

# Build Configuration
TARGET_ARCH=x86_64
BUILD_MODE=debug
TOOLCHAIN=multi-arch
BUILD_STRATEGY=optimization
PARALLEL_JOBS=4
OUTPUT_FORMAT=library

# Development Configuration
IFLIB_MODE=development
BROWSER_INTEGRATION=enabled
LOG_LEVEL=info
DEV_PORT=8083
DEBUG_PORT=2348
DOCS_PORT=3003

# Hardware Configuration
HARDWARE_PROFILE=optimization
QEMU_MEMORY=64M
QEMU_CPU=486

# Testing Configuration
TEST_SUITE=function-specs
SPEC_VALIDATION=enabled

# Documentation Configuration
DOC_FORMAT=markdown

# Function Specification Configuration
FUNCTION_SPECS_ENABLED=true
ARCHITECTURE_OPTIMIZATION=enabled
WEBAXP_NETWORK_API=enabled
BROWSER_SANDBOX=enabled

# Optimization Configuration
MULTI_ARCH_SUPPORT=enabled
PERFORMANCE_OPTIMIZATION=enabled
NETWORK_HARDWARE_ACCESS=enabled
PERMISSION_MANAGEMENT=enabled
