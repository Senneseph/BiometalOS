# Biometal Development Environment Configuration

# Project Information
PROJECT_NAME=Biometal
PROJECT_TYPE=reporting-layer
PROJECT_DESCRIPTION="Neural data collection and performance analysis layer"

# Build Configuration
TARGET_ARCH=x86_64
BUILD_MODE=debug
TOOLCHAIN=python
BUILD_STRATEGY=data-pipeline
PARALLEL_JOBS=4
OUTPUT_FORMAT=package

# Development Configuration
BIOMETAL_MODE=development
NEURAL_INTERFACE=enabled
LOG_LEVEL=info
DEV_PORT=8082
DEBUG_PORT=2347
DOCS_PORT=3002

# Hardware Configuration
HARDWARE_PROFILE=monitoring
QEMU_MEMORY=128M
QEMU_CPU=486

# Testing Configuration
TEST_SUITE=data-collection
SPEC_VALIDATION=enabled

# Documentation Configuration
DOC_FORMAT=markdown

# Neural Data Configuration
DATA_COLLECTION_ENABLED=true
ML_INTEGRATION_ENABLED=true
PERFORMANCE_MONITORING=enabled
BENCHMARKING_SUITE=comprehensive

# Data Analysis Configuration
STATISTICAL_ANALYSIS=enabled
OPTIMIZATION_HINTS=enabled
REPORTING_DASHBOARD=enabled
NEURAL_FEEDBACK=enabled
