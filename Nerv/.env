# Nerv Development Environment Configuration

# Project Information
PROJECT_NAME=Nerv
PROJECT_TYPE=microkernel
PROJECT_DESCRIPTION="Minimal microkernel inspired by Mach/Hurd architecture"

# Build Configuration
TARGET_ARCH=x86_64
BUILD_MODE=debug
TOOLCHAIN=gcc
BUILD_STRATEGY=microkernel
PARALLEL_JOBS=4
OUTPUT_FORMAT=elf

# Development Configuration
KERNEL_MODE=development
IPC_INTERFACE=mach-inspired
LOG_LEVEL=debug
DEV_PORT=8081
DEBUG_PORT=2346
DOCS_PORT=3001

# Hardware Configuration
HARDWARE_PROFILE=minimal
QEMU_MEMORY=32M
QEMU_CPU=486

# Testing Configuration
TEST_SUITE=kernel
SPEC_VALIDATION=enabled

# Documentation Configuration
DOC_FORMAT=markdown

# Mach/Hurd Configuration
MACH_COMPATIBILITY=enabled
HURD_TRANSLATORS=enabled
MESSAGE_PASSING=synchronous
PORT_MANAGEMENT=enabled

# Microkernel Configuration
MINIMAL_KERNEL=true
USER_SPACE_SERVICES=true
IPC_OPTIMIZATION=enabled
