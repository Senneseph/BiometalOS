# FuncOS Development Environment Configuration

# Project Information
PROJECT_NAME=FuncOS
PROJECT_TYPE=operating-system
PROJECT_DESCRIPTION="Function-oriented operating system with hardware abstraction"

# Build Configuration
TARGET_ARCH=x86_64
BUILD_MODE=debug
TOOLCHAIN=zig
BUILD_STRATEGY=off-the-shelf
PARALLEL_JOBS=4
OUTPUT_FORMAT=elf

# Development Configuration
FUNCOS_MODE=development
NEURAL_INTERFACE=stub
LOG_LEVEL=info
DEV_PORT=8080
DEBUG_PORT=2345
DOCS_PORT=3000

# Hardware Configuration
HARDWARE_PROFILE=detect
QEMU_MEMORY=64M
QEMU_CPU=486

# Testing Configuration
TEST_SUITE=all
SPEC_VALIDATION=enabled

# Documentation Configuration
DOC_FORMAT=markdown

# ZealOS Integration
ZEALOS_REPO=https://github.com/Senneseph/ZealOS
ZEALOS_BRANCH=main
ZEALOS_BUILD_TYPE=iso

# Service Configuration
SERVICE_DISCOVERY_ENABLED=true
SECURITY_CAPABILITIES_ENABLED=true
HARDWARE_ABSTRACTION_ENABLED=true
